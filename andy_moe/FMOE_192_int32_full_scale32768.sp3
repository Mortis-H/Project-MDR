//Design     Author: Zhang,Niels
//HostCode   Author: Zheng,Huan
//KernelCode Author: Zhang,Niels;Zheng,Huan
///////////////kernel limitation///////////////////////////////////////////////////
/////1. hidden_dim and dim should be multiple of 64                           /////
/////2. Gate/UP/Down should be pre-shuffled                                   /////
/////3. hidden_dim multiple of 64                                             /////
//////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////parameter description beginning////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////user input parameters///////////////////////////////////////////////////
//  belowing parameters has been passed in a buffer that pointed by s0,s1
//  name                size    offset       comment                                 sreg in kernel
//-----------------------------------------------------------------------------------------------------
//   R                   4       0x0       R address                                   s_R_buf
//   X                   4       0x10      X address                                   s_X_buf
//   G                   4       0x20      G address                                   s_G_buf
//   U                   4       0x30      U address                                   s_U_buf
//   D                   4       0x40      D address                                   s_D_buf
//   STP                 4       0x50      STP address                                 s_STP_buf
//   SW                  4       0x60      SW  address                                 s_SW_buf
//   SEP                 4       0x70      SEP address                                 s_SEP_buf
//   log2e               4       0x80      log2(e)                                     s_log2e
//   dim                 4       0x90      dim_size                                    s_dim_len
//   hidden_dim          4       0xA0      hidden_dim size                             s_hidden_len
//   topk                4       0xB0      topk cnt                                    s_tk      
//   eprt                4       0xC0      expert cnt                                  s_eprt
//   stride_X            4       0xD0      one token size of X (in bytes)              s_Xs
//   stride_GU           4       0xE0      one token size of GU (in bytes)             s_GUs
//   stride_D            4       0xF0      hidden-dim dimension size of D (in bytes)   s_Ds
//   stride_R            4       0x100     one token size of R(in bytes)               s_Rs
//   stride_expert_GU    4       0x110     one expert size of GU (in bytes)            s_eGUs
//   stride_expert_D     4       0x120     one expert size of D (in bytes)             s_eDs       
///////////////////////////////////////////////////////////////////////////////////////////
////////////////spi input/////////////////////////////////////////////////////////////////
// spi_set_reg      description            reg used by kernel
//--------------------------------------------------------------
//   s2          thread group idx            _s_tgid_x
//   s3          thread group idy            _s_tgid_y
//   s4          thread group idz             not used
//   v0           thread idx/y/z              v0,v1,v2 (threadidx,idy, idz)
//----------------------------------------------------------------------
// Above SPI input vaule should be derived by following threadgroup grid in host opencl code
// 1. global_size_x = (hidden_dim/sub_GU)*256
// 2. global_size_y = sub_X_cnt
// 3. global_size_z = 1
// 4. local_size_x = 256
// 5. local_size_y = 1
// 6. local_size_z = 1
////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////parmaeter description end///////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////

/////////////////macro definition////////////////////////////////////////
////////belowing macro could be tuned////////
/////////////////every explicit numbers below in comments are base on SUB_GU==512 for reference/////////////////////
var CNT_WV                      = 4
var SUB_X                       = 32
var SUB_GU                      = 192                               //192 for 32x192 kernel
var SUB_D                       = 256
var gemm0_SUB_K                 = 256
var gemm2_SUB_N                 = SUB_D

var DENO                        = 0x42fe0000                        //127
var DENO_FP8                    = 0x43700000                        //240
var FP8                         = 1
var Bpp                         = 1                                 //bytes per point
var PF_Bs                       = 2                                 //prefetch blk of QRLseD

var RDM                         = 1
var I_PL                        = 0
var USE_GELU                    = 0
var DO_SMOOTH                   = 0
var DO_UP                       = 1
var USE_VSKIP                   = 1                                 //use vskip or not when atomic_add
var GEMM2_OPT                   = 1
    if SUB_GU == 128
        GEMM2_OPT               = 0                                 // gemm2 opt for 128N has bugs
    end

var CNT_TG_STRIDE               = 16*CNT_WV                         //since tiled into 16(h_dim)*64(dim), and use 4 waves
var CNT_GU_ADDR                 = SUB_GU/CNT_TG_STRIDE              //8
var CNT_D_ADDR                  = SUB_D/CNT_WV/16                   //4
var CNT_D_HDIM_BLKS             = SUB_GU/64                         //8
var CNT_GU_Q                    = (CNT_GU_ADDR*16+63)/64            //2

var CNT_X_Q                     = SUB_X/16                          //2

///////non-tuned macro///////////////////////////////
var blk_32x256_mem_ld_insts     = 32*256*Bpp/256/4                  //8
var blk_32x256_lds_rd_insts     = 32*256*Bpp/1024                   //8
var blk_32x256_pad              = 32 *4                             //32DW
var blk_32x256_size             = 32*256*Bpp + blk_32x256_pad

var GU_256xSUB_GU_mem_ld_insts  = 256*SUB_GU*Bpp/1024/4             //32

var D_SUB_GUx256_mem_ld_insts      = SUB_GU*256*Bpp/1024/4             //32
var DQ_32x256_mem_ld_insts      = 1
var blk_32x256_cvt_insts        = 32*256/4/64/2                     //16

var R_32x256_lds_wr_insts       = 32*256*2/4/4/64/2                 //8
var R_32x256_lds_rd_insts       = R_32x256_lds_wr_insts*2           //16
var R_32x256_mem_atomic_insts   = R_32x256_lds_rd_insts             //16

////LDS addr definition//////////
var LDS_X_BASE                  = 0
var LDS_X_SIZE                  = blk_32x256_size*PF_Bs             //4160DW

var LDS_GMAX_BASE               = LDS_X_BASE        + LDS_X_SIZE
var LDS_GMAX_SIZE               = CNT_WV*SUB_X*4*4                  //512DW

var LDS_G_RSP_BASE              = LDS_GMAX_BASE     + LDS_GMAX_SIZE
var LDS_G_RSP_SIZE              = SUB_X*SUB_GU                      //4096DW

var LDS_R_BASE                  = LDS_G_RSP_BASE    + LDS_G_RSP_SIZE
var LDS_R_BLK_SIZE              = (16*64/2 + 8*4)*8*4               //4352DW
var LDS_R_SIZE                  = LDS_R_BLK_SIZE
if GEMM2_OPT == 1
    LDS_R_BASE                  = LDS_G_RSP_BASE        //reuse with G reshape 
    LDS_R_SIZE                  = LDS_R_BLK_SIZE*2      //8704DW
end

var max_lds                     = LDS_R_BASE        + LDS_R_SIZE

var vs_CD                       = 4
var vs_AB                       = 2
var NEG_INF                     = 0xff800000

//////sreg def//////////////
var s_tg_idx                    = s2
var s_tg_idy                    = s3
var s_tg_idz                    = s4

var s_eprt_idx                  = s5
var s_log2e                     = s6
var s_wave_id                   = s7

var _s_R_buf                    = 8
var _s_D_buf                    = 12
var _s_DQ_buf                   = 16

    var _s_atomic_exec          = 20                                //it will reuse 20-35 after gemm0
    var _s_restore_mask         = _s_atomic_exec+16                 //it will reuse 36-37 after gemm0
var _s_X_buf                    = 20
var _s_G_buf                    = 24
var _s_XQ_buf                   = 28
var _s_GQ_buf                   = 32
var _s_GsmQ_buf                 = 36
var _s_SW_buf                   = 40
var _s_STP_buf                  = 44
var _s_SEP_buf                  = _s_STP_buf        + 2             //46 
var _s_bf16_cvt                 = _s_SEP_buf        + 2             //48
var _s_X_lds_wr_base_m0         = _s_bf16_cvt       + 2             //50
    var _s_Xc_buf = _s_X_lds_wr_base_m0                             //50 re-used

//start from 52
var s_perm0                     = s52
var s_perm1                     = s53 
var s_perm2                     = s54
var s_perm3                     = s55
var s_D_buf_inc                 = s56
var s_X_buf_inc                 = s57
var s_G_buf_inc                 = s58
var s_R_buf_inc                 = s59

var s_tmp0                      = s60
var s_tmp1                      = s61
var s_tmp2                      = s62

var s_dim_len                   = s64
var s_hidden_len                = s65
var s_token_cnt                 = s66
var s_eprt_cnt                  = s67
var s_Xs                        = s68
var s_GUs                       = s69
var s_Ds                        = s70
var s_Rs                        = s71
var s_eGUs                      = s72
var s_eDs                       = s73
var s_eGUQs                     = s74
var s_eDQs                      = s75
var s_eGsmQs                    = s76

var s_c1                        = s77
var s_D_hf_buf_inc              = s78
var s_DQ_buf_inc                = s79

var s_loop_idx                  = s80
var s_loop_cnt                  = s81

var _s_token_idx                = 82
var _s_U_buf_inc                = _s_token_idx      + 8
var _s_U_buf                    = _s_U_buf_inc      + 1
_s_U_buf                        = (_s_U_buf+3)/4*4
var _s_end                      = _s_U_buf          + 4
////////////////////////////////////////
var Vsrc63_48   = 0x00040000
var Vsrc95_64   = 0xfffffff0
var Vsrc127_96  = 0x00020000
///////////////////////////////////////

/////vreg def////////////////
var sz_vDQ                      = 1

var _v_c2                       = 1
var _v_X_lds_rd                 = 2
var _v_R_lds_wr                 = _v_X_lds_rd + 1                   //3
var _v_R_lds_rd                 = _v_R_lds_wr + 1                   //4
var _v_DQ_addr                  = _v_R_lds_rd + 1                   //5
var _v_XQ_addr                  = _v_DQ_addr  + 1                   //6
var _v_W_addr                   = _v_XQ_addr  + 2                   //8
var _v_GQ_addr                  = _v_W_addr   + 2                   //10
var _v_DQ                       = _v_GQ_addr  + CNT_GU_Q            //12
var _v_XQ                       = _v_DQ       + sz_vDQ*PF_Bs        //14 
var _v_GQ                       = _v_XQ       + CNT_X_Q             //16 
var _v_GsmQ                     = _v_GQ       + CNT_GU_Q            //18
var _v_W                        = _v_GsmQ     + CNT_GU_Q            //20
var _v_Max                      = _v_W        + 2                   //22
    _v_Max                      =((_v_Max+1)/2)*2
var _v_ZdynQ                    = _v_Max      + CNT_X_Q             //24
var _v_X_addr                   = _v_ZdynQ    + 2                   //26
var _v_GU_addr                  = _v_X_addr   + 8                   //34
var _v_D_addr                   = _v_GU_addr  + CNT_GU_ADDR         //42
var _v_bf16_cvt                 = _v_D_addr   + CNT_D_ADDR          //46
var _v_UQ                       = _v_bf16_cvt + 4                   //50
var _v_tmp                      = _v_UQ       + CNT_GU_Q            //52
    _v_tmp                      = ((_v_tmp+1)/2)*2

var _v_R_save                   = 64
var _v_R_save_reg_size          = 16

var _v_R_addr                   = _v_R_save   + _v_R_save_reg_size  //[80] 
var _v_R_addr_reg_size          = 16

var _v_GMAX                     = _v_R_addr   + _v_R_addr_reg_size  //[96]
var _v_GMAX_reg_size            = (SUB_X/16)*CNT_WV*4               //32

var _v_Z                        = _v_GMAX     + _v_GMAX_reg_size    //[128]
var sz_vP                       = SUB_X*SUB_GU*Bpp/4/64             //64
var _v_Z_reg_size               = SUB_X*SUB_GU/4/64                 //64

var _v_GM1                      = _v_R_save                         //reuse this portion 64~127 when GEMM1 
var _v_GM1_size                 = _v_Z_reg_size                     //same as GEMM0 size

var _v_X                        = _v_Z        +_v_Z_reg_size        //[192]
var sz_vX                       = SUB_X*256*Bpp/4/64                //32
var _v_X_reg_size               = sz_vX*2                           //64

var _v_R                        = _v_X                              //reused with X---- [192]
var sz_vR                       = SUB_X*256/4/64                    //32
var _v_R_reg_size               = sz_vR*2                           //64

var _v_arc_end                  = _v_R        + _v_R_reg_size-1     //255
 

//ACC_VGPR
var _v_G                        = 0
var sz_vGU                      = SUB_GU*256*Bpp/4/4/64             //128
var _v_G_reg_size               = sz_vGU*2                          //256

var _v_D                        = 0                                 //---reused with v_G
var sz_vD                       = SUB_GU*256*Bpp/4/4/64             //128
var _v_D_reg_size               = sz_vD*2                           //256

var _v_acc_end                  = _v_D        + _v_D_reg_size-1     //255
//////////////////
label label_wave01_core_loop
label label_wave23_core_loop
label label_main_loops_exit
label label_aligned_exit
label label_actv[2]
label label_gemm0[2]
label label_gemm2[2]
