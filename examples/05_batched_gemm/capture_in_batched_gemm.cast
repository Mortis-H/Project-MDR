[36.78476, "o", "[Info] Extracted 15 metadata attributes from cap.s\r\n\r\n=== Stage 4: Running MLIR optimization pipeline ===\r\n[$] mlir-opt cap_output/cap_clobber.gpumlir --pass-pipeline=builtin.module(gpu-kernel-outlining,rocdl-attach-target{chip=gfx942},gpu.module(convert-scf-to-cf,convert-gpu-to-rocdl{index-bitwidth=32 runtime=HIP}),gpu-to-llvm,gpu-module-to-binary{format=isa}) -o cap_output/cap_clobber_binary.mlir\r\n"]
[36.826563, "o", "Generated final ISA: cap_output/cap_clobber_final.s\r\n\r\n=== Stage 5: Assembling ISA to object file ===\r\n[$] llvm-mc -triple amdgcn-amd-amdhsa -mcpu=gfx942 -filetype=obj cap_output/cap_clobber_final.s -o cap_output/cap_clobber.o\r\n"]
[36.831582, "o", "\r\n=== Stage 6: Linking to HSACO ===\r\n[$] lld -flavor gnu -m elf64_amdgpu --no-undefined -shared -plugin-opt=-amdgpu-internalize-symbols -plugin-opt=mcpu=gfx942 --whole-archive cap_output/cap_clobber.o --no-whole-archive -o cap_output/cap_clobber.hsaco\r\n"]
